<?xml version="1.0"?>
<package format="3">
  <name>perception_camera_py</name>
  <version>0.2.0</version>
  <description>ROS 2 Python camera perception node for the PBV feasibility DCU ROS2-only workspace.</description>
  <maintainer email="openai@example.com">OpenAI</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>pbv_dcu_interfaces</depend>
  <depend>rcl_interfaces</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
