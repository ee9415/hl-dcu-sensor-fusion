CM_ BO_ 288 "Left/right encoder speed and averaged vehicle speed.";
CM_ BO_ 289 "Steering target, ADC feedback, PWM command, and control state.";
CM_ BO_ 290 "Drive duty, direction enable, E-STOP state, speed buffer count, and encoder deltas.";
VAL_ 290 DriveDirection 0 "Stop" 1 "Forward" 2 "Reverse" ;
CM_ BO_ 291 "Raw accumulated encoder counts for left and right wheels.";
CM_ BO_ 292 "Encoder debug counts and forward-positive CAN-frame deltas. Left count is GPT12 T3 raw count; right count is GPT12 T2 raw count.";
CM_ BO_ 293 "Speed controller target/current rpm and duty command/feedforward.";
CM_ BO_ 294 "Raw and averaged wheel rpm for CANoe plots.";
CM_ BO_ 295 "Steering potentiometer feedback angle, ADC raw/mV, and target-current steering error.";
CM_ BO_ 304 "Consolidated 50 Hz encoder-speed and steering-potentiometer feedback used by the PC safety/controller path. Byte7 high nibble must be 0xD.";
CM_ BO_ 768 "PC Ackermann command, standard CAN DLC8, little-endian. Speed is signed: -0.70 km/h reverse through +13.00 km/h forward. Steering is +LEFT/-RIGHT. Byte7 must be 0xA0 STOP or 0xA1 enabled; valid unique frames must arrive within 250 ms.";
CM_ SG_ 768 SteeringPulseUs "Redundant angle check: +27deg=1150us, 0deg=1515us, -27deg=1950us, tolerance 3us.";
VAL_ 768 CommandFlags 160 "SignatureValid_Disabled" 161 "SignatureValid_Enabled" ;
VAL_ 304 EncoderSpeedValid 0 "Invalid" 1 "Valid" ;
VAL_ 304 SteeringPotValid 0 "Invalid" 1 "Valid" ;
VAL_ 304 PcControlActive 0 "Inactive" 1 "Active" ;
VAL_ 304 SensorFeedbackEstop 0 "Released" 1 "Active" ;
VAL_ 304 SensorFeedbackSignature 13 "Valid" ;
