Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
    - Class: rviz_default_plugins/MarkerArray
      Name: Waypoints and Vehicle
      Enabled: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /jigu/rviz_markers
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Driven GPS Path
      Enabled: true
      Topic:
        Value: /jigu/gps_path
      Line Style: Lines
      Line Width: 0.10
      Color: 255; 120; 40
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Scale: 20
Window Geometry:
  Width: 1200
  Height: 800
