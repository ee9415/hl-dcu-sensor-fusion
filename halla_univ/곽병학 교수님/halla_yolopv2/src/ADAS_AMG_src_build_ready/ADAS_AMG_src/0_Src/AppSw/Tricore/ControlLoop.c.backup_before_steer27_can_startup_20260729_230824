    uint16 targetRaw;

    g_pcCommandControlActive = 0u;
    g_pcCommandFailsafeActive = 0u;

    if (g_joystickPriorityActive != 0u)
    {
        return;
    }

    if (g_pcCommandModeSeen == 0u)
    {
        /*
         * No joystick and no PC command means nobody owns steering yet.
         * Keep the calibrated neutral PWM, but do not close the external
         * potentiometer loop around center.  Leaving targetValid set here
         * makes ADC noise/linkage backlash drive a left/right limit cycle
         * even though the camera host has transmitted no CAN frames.
         */
        ControlLoop_SetSteeringPotTargetRaw(g_steeringPotRawCenter, FALSE);
        ControlLoop_SetManualSteeringPulse(STEERING_SERVO_CENTER_US, TRUE);
        return;
    }

    ControlLoop_DisableTestModesForRemoteControl();

    if ((g_pcCommandValid != 0u) && (g_pcCommandEnabled != 0u))
    {
        targetRaw = ControlLoop_MapPcSteeringDegX10ToRaw(g_pcCommandSteeringDegX10);
        g_pcCommandAppliedSteeringRaw = targetRaw;
        g_targetSteeringDeg = (float32)g_pcCommandSteeringDegX10 / 10.0f;
        ControlLoop_SetTargetVehicleKph((float32)g_pcCommandSpeedKphX100 / 100.0f);
        ControlLoop_SetSteeringPotTargetRaw(targetRaw, TRUE);
        ControlLoop_SetManualSteeringPulse(g_pcCommandSteeringPulseUs, TRUE);
        g_pcCommandControlActive = 1u;
        return;
    }

    /* Explicit disabled command, invalid packet, manual takeover, or timeout. */
    if (g_pcCommandValid == 0u)
    {
        g_pcCommandFailsafeActive = 1u;
    }

    g_targetSteeringDeg = 0.0f;
    g_pcCommandAppliedSteeringRaw = g_steeringPotRawCenter;
    ControlLoop_StopDriveNow();
    /* Do not let the normal zero-speed position hold re-apply motor torque. */
    g_speedControlEnabled = 0u;
    /*
     * A disabled PC frame is a drive STOP, not steering ownership.  Disable
     * the external potentiometer loop so a camera process that has not been
     * armed cannot make the wheels hunt around the calibrated center.
     */
    ControlLoop_SetSteeringPotTargetRaw(g_steeringPotRawCenter, FALSE);
    ControlLoop_SetManualSteeringPulse(STEERING_SERVO_CENTER_US, TRUE);
}

